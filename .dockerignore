# Same shape as .gitignore -- keeps the build context small and stops
# host-machine artifacts (which won't match the container's platform/arch
# anyway) from ever being copied in.
node_modules
.next
out
build
.data

.env
.env*.local

.git
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

*.tsbuildinfo
next-env.d.ts.bak

.claude
