# Used by Prisma Migrate/CLI. Elevated/admin role (superuser locally), needs
# DDL privileges to create tables, roles, and Row-Level Security policies.
DATABASE_URL="postgresql://hms:hms@localhost:5432/hms?schema=public"

# Used by the running Next.js app's PrismaClient. Restricted, non-superuser
# role subject to Row-Level Security -- provisioned by
# prisma/migrations/*_add_row_level_security. Must be a *different* role than
# DATABASE_URL's, since RLS does not apply to Postgres superusers.
APP_DATABASE_URL="postgresql://hms_app:hms_app_dev_only@localhost:5432/hms?schema=public"

# Secret used to sign session cookies (src/shared/session.ts). Generate a real
# random value for any non-local environment, e.g. `openssl rand -hex 32`.
SESSION_SECRET="dev-only-session-secret-change-me"

# Shared-platform tenant resolution (src/tenants/resolve-hospital.ts, BRS
# FR-1.7): the app's own root domain. Requests to "<subdomain>.<ROOT_DOMAIN>"
# resolve to the Hospital with that subdomain. Unset locally -- defaults to
# "localhost", so "<subdomain>.localhost:3000" resolves a real hospital with
# no /etc/hosts editing. Set to the real domain (e.g. "hms-platform.in") in
# production.
# ROOT_DOMAIN="hms-platform.in"

# Gates /onboarding (src/app/onboarding), the minimal hospital-onboarding
# form -- entered directly in that form, not a login. Generate a real random
# value for any non-local environment, e.g. `openssl rand -hex 32`, and never
# commit it.
PLATFORM_ADMIN_SECRET="dev-only-onboarding-secret-change-me"

# Consumed once by `npm run prisma:bootstrap` (prisma/bootstrap.mjs) to
# create the platform's first Hospital + Hospital Admin on a fresh
# deployment -- see that file and "Shared-platform tenant resolution" in
# CLAUDE.md. Safe to leave set after bootstrapping; the script no-ops once
# any hospital exists.
# BOOTSTRAP_HOSPITAL_NAME="Real Hospital Name"
# BOOTSTRAP_HOSPITAL_SUBDOMAIN="realhospital"
# BOOTSTRAP_ADMIN_NAME="Real Admin Name"
# BOOTSTRAP_ADMIN_EMAIL="admin@realhospital.example"
# BOOTSTRAP_ADMIN_PASSWORD="change-me-to-a-real-password"
