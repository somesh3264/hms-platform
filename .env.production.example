# Template for .env.production on the VPS -- never commit the real file.
# Used by: docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# Generate every secret below fresh, on the VPS, with:
#   openssl rand -hex 32
# Never reuse a value from .env.example or from this file verbatim -- those
# are dev-only placeholders.

# ---- Postgres ----
# The `hms`/`hms` credentials in the local docker-compose.yml are
# dev-only. Pick a real user/password/db name for production.
POSTGRES_USER="hms_admin"
POSTGRES_PASSWORD="generate-a-real-password-here"
POSTGRES_DB="hms"

# Elevated/admin connection string Prisma Migrate uses -- built from the
# three POSTGRES_* values above, host is "postgres" (the compose service
# name, not localhost -- containers reach each other by service name on
# the compose network).
DATABASE_URL="postgresql://hms_admin:generate-a-real-password-here@postgres:5432/hms?schema=public"

# Restricted connection string the *running app* uses -- this is the
# `hms_app` role the RLS migration creates automatically. IMPORTANT: that
# migration hardcodes hms_app's initial password to a dev-only placeholder
# ("hms_app_dev_only", see prisma/migrations/*_add_row_level_security).
# Immediately after running `prisma migrate deploy` in production (Phase
# 03), connect as the admin role and rotate it:
#
#   ALTER ROLE hms_app WITH PASSWORD 'the-real-password-you-put-below';
#
# Then set that same password here. Skipping this step means your
# production app database is protected by a password that's sitting in
# this repo's git history.
APP_DATABASE_URL="postgresql://hms_app:the-real-password-you-put-below@postgres:5432/hms?schema=public"

# ---- App ----
SESSION_SECRET="generate-a-real-random-value-here"
PLATFORM_ADMIN_SECRET="generate-a-real-random-value-here"

# The real domain you point at this VPS (wildcard DNS record
# *.ROOT_DOMAIN -> this VPS's IP). No "https://", no subdomain, no
# trailing slash.
ROOT_DOMAIN="hms-platform.in"

# ---- Hospital #1 bootstrap (consumed once by prisma:bootstrap, then
# safe to leave set -- see prisma/bootstrap.mjs) ----
BOOTSTRAP_HOSPITAL_NAME="Real Hospital Name"
BOOTSTRAP_HOSPITAL_SUBDOMAIN="realhospital"
BOOTSTRAP_ADMIN_NAME="Real Admin Name"
BOOTSTRAP_ADMIN_EMAIL="admin@realhospital.example"
BOOTSTRAP_ADMIN_PASSWORD="generate-a-real-password-here"
