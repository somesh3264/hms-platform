generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev (whatever platform that happens to be);
  // "linux-musl-openssl-3.0.x" is pinned explicitly for the production
  // Docker image (node:20-alpine) rather than relying solely on
  // auto-detection at generate time, which has already mismatched what the
  // runtime image actually needed once.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Every tenant-owned table carries hospital_id directly (not only reachable via
// a join) so PostgreSQL Row-Level Security policies can filter on it uniformly,
// per TRD Section 2.3 / Section 8. The policies themselves are hand-written SQL
// (Prisma has no declarative RLS support) -- see
// prisma/migrations/*_add_row_level_security/migration.sql, and
// src/shared/tenant-context.ts for how the app satisfies them at query time.

model Hospital {
  id                 String         @id @default(cuid())
  name               String
  // Tenant-resolution key for the shared-platform deployment model (BRS
  // FR-1.7): requests are routed by the subdomain of the Host header
  // (e.g. "apollo" for apollo.yourdomain.com) rather than a hardcoded
  // "oldest active hospital" shortcut -- see src/tenants/resolve-hospital.ts.
  // Lowercase, URL-safe, unique across the whole platform (not just per
  // hospital, since there is no enclosing scope narrower than "the
  // deployment" for this field).
  subdomain          String         @unique
  logoUrl            String?        @map("logo_url")
  // Hospital Admin-uploaded UPI QR code (FR-7.5-adjacent, a later,
  // explicitly requested addition), shown wherever staff can select UPI as
  // a payment method so the patient can scan-to-pay directly. Same
  // upload/storage pattern as logoUrl, not a raw UPI ID/VPA -- see
  // saveHospitalUpiQrCode in src/shared/storage.ts.
  upiQrCodeUrl       String?        @map("upi_qr_code_url")
  address            String?
  contactPhone       String?        @map("contact_phone")
  contactEmail       String?        @map("contact_email")
  // Shown on the printable bill's letterhead (src/app/billing/[billId]) --
  // a later, explicitly requested addition once the hospital gave a
  // reference bill format that includes it.
  website            String?
  gstin              String?
  // Clinical establishment registration number (e.g. a state health
  // department registration, distinct from GSTIN) -- shown on the printed
  // prescription form's letterhead (src/app/front-desk/prescription-form),
  // a later, explicitly requested addition once the hospital's real
  // letterhead photo showed it printed there.
  registrationNumber String?        @map("registration_number")
  // The in-house medical store often trades under its own registered name
  // and GSTIN, distinct from the hospital's own -- shown on the printable
  // bill (src/app/billing/[billId]) in place of the hospital's own
  // name/gstin whenever a bill contains a MEDICINE line item, since that
  // makes it a transaction of the pharmacy entity, not the hospital's own.
  // Nullable: falls back to the hospital's own name/gstin when unset,
  // rather than forcing every hospital to configure a separate pharmacy
  // identity it may not have.
  pharmacyName       String?        @map("pharmacy_name")
  pharmacyGstin      String?        @map("pharmacy_gstin")
  themeColor         String?        @map("theme_color")
  status             HospitalStatus @default(ACTIVE)

  // Default low-stock alert threshold (% of reorder level), FR-6.6/FR-6.7.
  // Overridable per medicine via Medicine.lowStockThresholdPercent.
  lowStockThresholdPercent Int @default(30) @map("low_stock_threshold_percent")

  // Monotonically incremented per hospital to derive Patient.patientCode
  // (FR-3.3). Incremented via an atomic UPDATE ... RETURNING in the same
  // transaction as patient creation -- see src/patients/patient-code.ts.
  patientCodeSeq Int @default(0) @map("patient_code_seq")

  // Same pattern as patientCodeSeq, for Bill.billNumber (FR-7.1/7.7) --
  // see src/billing/bill-number.ts.
  billNumberSeq Int @default(0) @map("bill_number_seq")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users              User[]
  patients           Patient[]
  visits             Visit[]
  prescriptions      Prescription[]
  medicines          Medicine[]
  bills              Bill[]
  billLineItems      BillLineItem[]
  auditLogs          AuditLog[]
  dailyTokenCounters DailyTokenCounter[]

  @@map("hospitals")
}

enum HospitalStatus {
  ACTIVE
  SUSPENDED

  @@map("hospital_status")
}

enum UserRole {
  SUPER_ADMIN
  HOSPITAL_ADMIN
  FRONT_DESK
  DOCTOR
  PHARMACIST

  @@map("user_role")
}

model User {
  id              String   @id @default(cuid())
  hospitalId      String   @map("hospital_id")
  hospital        Hospital @relation(fields: [hospitalId], references: [id])
  name            String
  email           String
  passwordHash    String   @map("password_hash")
  role            UserRole
  department      String?
  isActive        Boolean  @default(true) @map("is_active")
  // Marks the one doctor who sees a patient first, before any referral to a
  // specialist -- front desk's "Assign doctor" dropdown shows this doctor
  // as "Shivgeet hospital" instead of their own name (a later, explicitly
  // requested addition, client-specific wording, not derived from
  // Hospital.name), since front desk/patients think of seeing "the
  // hospital" rather than needing to know a specific doctor's name up
  // front. An explicit flag, not inferred from e.g. "oldest doctor
  // account" -- this codebase already replaced exactly that kind of
  // implicit shortcut once for hospital resolution (see
  // resolveCurrentHospitalId's removed "oldest ACTIVE hospital" fallback)
  // after flagging it as a silent-wrong-tenant risk; the same reasoning
  // applies here; not DB-enforced as at-most-one-per-hospital (no unique
  // partial index), same as other soft invariants in this codebase --
  // keep it that way when setting it.
  isPrimaryDoctor Boolean  @default(false) @map("is_primary_doctor")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  visitsAsDoctor        Visit[]        @relation("VisitDoctor")
  prescriptionsUploaded Prescription[] @relation("PrescriptionUploadedBy")
  auditLogs             AuditLog[]     @relation("AuditLogActor")

  @@unique([hospitalId, email])
  @@index([hospitalId])
  @@map("users")
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN

  @@map("gender")
}

model Patient {
  id          String   @id @default(cuid())
  hospitalId  String   @map("hospital_id")
  hospital    Hospital @relation(fields: [hospitalId], references: [id])
  patientCode String   @map("patient_code")
  name        String
  age         Int
  gender      Gender   @default(UNKNOWN)
  phone       String?
  email       String?
  address     String?

  // DPDP Act 2023 opt-in consent for digital delivery of bills/prescriptions (FR-10.3).
  consentDigitalDelivery Boolean @default(false) @map("consent_digital_delivery")

  medicalHistoryNotes String? @map("medical_history_notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  visits        Visit[]
  prescriptions Prescription[]
  bills         Bill[]

  @@unique([hospitalId, patientCode])
  @@index([hospitalId, phone])
  @@index([hospitalId])
  @@map("patients")
}

enum VisitStatus {
  WAITING
  IN_CONSULTATION
  COMPLETED
  CANCELLED

  @@map("visit_status")
}

model Visit {
  id         String      @id @default(cuid())
  hospitalId String      @map("hospital_id")
  hospital   Hospital    @relation(fields: [hospitalId], references: [id])
  patientId  String      @map("patient_id")
  patient    Patient     @relation(fields: [patientId], references: [id])
  doctorId   String      @map("doctor_id")
  doctor     User        @relation("VisitDoctor", fields: [doctorId], references: [id])
  department String?
  status     VisitStatus @default(WAITING)

  // Free-text notes captured by the doctor alongside the scanned prescription (FR-4.4).
  consultationNotes String? @map("consultation_notes")

  // Daily front-desk queue/token number (FR-3.7/FR-3.8), assigned at visit
  // creation time via DailyTokenCounter -- see src/visits/token-number.ts.
  // Nullable: rows created before this field existed have none. Display
  // only -- queue/next-patient ordering stays based on visitDate, not this.
  tokenNumber Int? @map("token_number")

  visitDate DateTime @default(now()) @map("visit_date")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  prescriptions Prescription[]
  bills         Bill[]

  @@index([hospitalId, patientId])
  @@index([hospitalId, doctorId])
  @@map("visits")
}

// Backs Visit.tokenNumber (FR-3.7/FR-3.8): one row per (hospital, calendar
// day in IST -- see src/shared/ist-date.ts), incremented atomically via
// `INSERT ... ON CONFLICT ... DO UPDATE ... RETURNING` in
// src/visits/token-number.ts rather than a read-then-write, so concurrent
// front-desk registrations can't collide. Scoped per hospital only, not per
// doctor/department -- matches a single physical token dispenser at the
// front desk. A pure counter row, not a user-facing entity, so the
// composite key is the primary key rather than a separate id.
model DailyTokenCounter {
  hospitalId String   @map("hospital_id")
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  tokenDate  DateTime @map("token_date") @db.Date
  lastToken  Int      @default(0) @map("last_token")

  @@id([hospitalId, tokenDate])
  @@map("daily_token_counters")
}

enum PrescriptionStatus {
  UPLOADED
  DISPENSED
  SUPERSEDED

  @@map("prescription_status")
}

model Prescription {
  id           String   @id @default(cuid())
  hospitalId   String   @map("hospital_id")
  hospital     Hospital @relation(fields: [hospitalId], references: [id])
  visitId      String   @map("visit_id")
  visit        Visit    @relation(fields: [visitId], references: [id])
  patientId    String   @map("patient_id")
  patient      Patient  @relation(fields: [patientId], references: [id])
  uploadedById String   @map("uploaded_by_id")
  uploadedBy   User     @relation("PrescriptionUploadedBy", fields: [uploadedById], references: [id])

  // Object-storage reference to the scanned image/PDF (FR-5.2/FR-5.5).
  fileUrl  String  @map("file_url")
  fileType String  @map("file_type")
  notes    String?

  status PrescriptionStatus @default(UPLOADED)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  billLineItems BillLineItem[]

  @@index([hospitalId, visitId])
  @@index([hospitalId, status])
  @@map("prescriptions")
}

model Medicine {
  id              String    @id @default(cuid())
  hospitalId      String    @map("hospital_id")
  hospital        Hospital  @relation(fields: [hospitalId], references: [id])
  name            String
  saltComposition String?   @map("salt_composition")
  batchNumber     String?   @map("batch_number")
  expiryDate      DateTime? @map("expiry_date")
  unitPriceCents  Int       @map("unit_price_cents")
  stockQuantity   Int       @default(0) @map("stock_quantity")
  reorderLevel    Int       @default(0) @map("reorder_level")

  // Per-medicine override of Hospital.lowStockThresholdPercent (FR-6.7).
  lowStockThresholdPercent Int? @map("low_stock_threshold_percent")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  billLineItems BillLineItem[]

  @@index([hospitalId, name])
  @@index([hospitalId, expiryDate])
  @@map("medicines")
}

enum PaymentMethod {
  UPI
  CASH
  CARD

  @@map("payment_method")
}

enum PaymentStatus {
  PENDING
  PAID

  @@map("payment_status")
}

model Bill {
  id         String   @id @default(cuid())
  hospitalId String   @map("hospital_id")
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  // Nullable: a Counter Sale (src/billing/counter-sale.ts, a walk-in
  // medicine purchase with no doctor consultation involved) has no Visit
  // to attach to. Every other Bill still always has one -- this only
  // widens what's *possible*, nothing about the existing front-desk/
  // pharmacist billing flows changes.
  visitId    String?  @map("visit_id")
  visit      Visit?   @relation(fields: [visitId], references: [id])
  patientId  String   @map("patient_id")
  patient    Patient  @relation(fields: [patientId], references: [id])

  billNumber String @map("bill_number")

  subtotalCents Int @default(0) @map("subtotal_cents")
  discountCents Int @default(0) @map("discount_cents")
  taxCents      Int @default(0) @map("tax_cents")
  totalCents    Int @default(0) @map("total_cents")

  paymentMethod    PaymentMethod? @map("payment_method")
  paymentStatus    PaymentStatus  @default(PENDING) @map("payment_status")
  // UPI UTR / transaction reference, or a cash receipt note (FR-7.5).
  paymentReference String?        @map("payment_reference")

  issuedAt DateTime? @map("issued_at")
  paidAt   DateTime? @map("paid_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lineItems BillLineItem[]

  @@unique([hospitalId, billNumber])
  @@index([hospitalId, patientId])
  @@map("bills")
}

enum BillLineItemType {
  MEDICINE
  SERVICE

  @@map("bill_line_item_type")
}

model BillLineItem {
  id         String   @id @default(cuid())
  hospitalId String   @map("hospital_id")
  hospital   Hospital @relation(fields: [hospitalId], references: [id])

  // Nullable: dispensing (FR-6.5) creates a line item the moment medicines are
  // issued, before a Bill exists -- the not-yet-built billing module (BRS 3.7)
  // attaches unbilled items (billId IS NULL) to a real Bill later.
  billId String? @map("bill_id")
  bill   Bill?   @relation(fields: [billId], references: [id])

  // Nullable: only set for MEDICINE line items; service charges (e.g. consultation fee,
  // FR-7.3) have no medicine reference.
  medicineId String?   @map("medicine_id")
  medicine   Medicine? @relation(fields: [medicineId], references: [id])

  // The prescription this dispensed medicine line item fulfils, if applicable.
  prescriptionId String?       @map("prescription_id")
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id])

  itemType       BillLineItemType @map("item_type")
  description    String
  quantity       Int              @default(1)
  unitPriceCents Int              @map("unit_price_cents")
  lineTotalCents Int              @map("line_total_cents")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([hospitalId, billId])
  @@map("bill_line_items")
}

model AuditLog {
  id         String   @id @default(cuid())
  hospitalId String   @map("hospital_id")
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  actorId    String   @map("actor_id")
  actor      User     @relation("AuditLogActor", fields: [actorId], references: [id])

  action     String
  entityType String @map("entity_type")
  entityId   String @map("entity_id")
  metadata   Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([hospitalId, entityType, entityId])
  @@index([hospitalId, createdAt])
  @@map("audit_logs")
}
